name: particle-life-sim

on:
  push:
    paths:
      - 'particle-life-sim/**'
  pull_request:
    paths:
      - 'particle-life-sim/**'

jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: particle-life-sim
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: python -m pip install --upgrade pip
      - run: pip install -e .[dev]
      - run: pytest
